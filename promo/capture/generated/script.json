 "edits": {
  "convex/usage.ts": {
   "diff": "@@ -1,5 +1,7 @@\n import { v } from \"convex/values\";\n-import { internalMutation } from \"./_generated/server\";\n+import { internalMutation, query } from \"./_generated/server\";\n+import { requireAccount } from \"./auth\";\n+import { cycleStart } from \"./billing\";\n \n export const recordUsage = internalMutation({\n   args: { accountId: v.id(\"accounts\"), kind: v.string(), amount: v.number() },\n@@ -14,3 +16,20 @@\n     return null;\n   },\n });\n+\n+/** This billing cycle's transcription minutes, read from the daily aggregates rather than the raw events. */\n+export const currentCycleUsage = query({\n+  args: {},\n+  returns: v.object({ used: v.number(), limit: v.number(), resetsAt: v.number() }),\n+  handler: async (ctx) => {\n+    const account = await requireAccount(ctx);\n+    const days = await ctx.db\n+      .query(\"usageDaily\")\n+      .withIndex(\"by_account_and_day\", (q) =>\n+        q.eq(\"accountId\", account._id).gte(\"day\", cycleStart(account.billing)),\n+      )\n+      .collect();\n+    const used = days.reduce((sum, day) => sum + day.transcriptionMinutes, 0);\n+    return { used, limit: account.billing.minutesIncluded, resetsAt: account.billing.cycleEndsAt };\n+  },\n+});",
   "added": 20,
   "removed": 1
  },
  "src/components/UsageMeter.tsx": {
   "diff": "@@ -0,0 +1,36 @@\n+import { useQuery } from \"convex/react\";\n+import { api } from \"../../convex/_generated/api\";\n+import { useI18n } from \"../i18n\";\n+\n+const WARN_AT = 0.8;\n+\n+export function UsageMeter() {\n+  const usage = useQuery(api.usage.currentCycleUsage);\n+  const t = useI18n();\n+  if (!usage) return <div className=\"usage-meter usage-meter--loading\" />;\n+\n+  const ratio = usage.limit > 0 ? Math.min(usage.used / usage.limit, 1) : 0;\n+  const tone = ratio >= 1 ? \"over\" : ratio >= WARN_AT ? \"warn\" : \"ok\";\n+\n+  return (\n+    <section className={`usage-meter usage-meter--${tone}`} aria-label={t(\"usage.title\")}>\n+      <header>\n+        <h3>{t(\"usage.title\")}</h3>\n+        <span>{t(\"usage.resets\", { date: new Date(usage.resetsAt) })}</span>\n+      </header>\n+      <div\n+        className=\"usage-meter__bar\"\n+        role=\"meter\"\n+        aria-valuemin={0}\n+        aria-valuemax={usage.limit}\n+        aria-valuenow={usage.used}\n+      >\n+        <div className=\"usage-meter__fill\" style={{ width: `${ratio * 100}%` }} />\n+      </div>\n+      <p>\n+        {t(\"usage.minutes\", { used: Math.round(usage.used), limit: usage.limit })}\n+        {tone === \"over\" && <strong> {t(\"usage.over\")}</strong>}\n+      </p>\n+    </section>\n+  );\n+}",
   "added": 36,
   "removed": 0
