<?xml version="1.0" encoding="utf-8"?>
<!--
  The animated "working" glyph of a running row, for RemoteViews (see @drawable/widget_working_steps): an
  indeterminate ProgressBar whose indeterminate drawable is the frame animation, which it starts itself on first
  draw. Fills the slot it is placed in (the 16dp glyph slot, the 12dp one beside a Project's count); tinted
  `iconSecondary` — this variant follows the launcher's day / night mode (the widget's "Match system" theme) — unless
  the widget sets a tint on @id/widget_working_glyph, as it does from Android 12 for a Project's own colour.
-->
<ProgressBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_working_glyph"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:indeterminate="true"
    android:indeterminateDrawable="@drawable/widget_working_steps"
    android:indeterminateOnly="true"
    android:indeterminateTint="@color/widget_icon_secondary"
    android:maxHeight="16dp"
    android:maxWidth="16dp"
    android:minHeight="0dp"
    android:minWidth="0dp" />
