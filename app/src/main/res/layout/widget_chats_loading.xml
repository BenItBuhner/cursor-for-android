<?xml version="1.0" encoding="utf-8"?>
<!--
  What the launcher shows between placing the widget and its first render: the sidebar surface with the sidebar's
  "Loading chats…" line (12sp at 36 %). Follows the system theme; the render that replaces it follows the app's.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:backgroundTint="@color/widget_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_text_quaternary"
        android:textSize="12sp" />
</FrameLayout>
