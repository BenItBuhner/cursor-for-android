    <color name="widget_text_primary">#141414</color>
    <color name="widget_text_tertiary">#99141414</color>
    <color name="widget_text_quaternary">#5C141414</color>
    <color name="widget_icon_secondary">#A8141414</color>
    <color name="widget_icon_tertiary">#85141414</color>
    <color name="widget_icon_quaternary">#47141414</color>
    <color name="widget_unread_dot">#2778C1</color>
    <color name="widget_error_dot">#CE405B</color>
