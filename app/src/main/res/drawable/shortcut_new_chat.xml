<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher shortcut for a new chat: an adaptive icon the launcher masks like the app icon's — the app icon's
  own dark background with the "+" in white in the safe zone (shortcut_new_chat_foreground).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/shortcut_new_chat_foreground" />
</adaptive-icon>
