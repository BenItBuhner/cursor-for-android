<?xml version="1.0" encoding="utf-8"?>
<!--
  The sidebar's "working" glyph as a frame animation: the web's eight arrangements at 175 ms a step (a 1.4 s loop),
  transcribed in `RunningGlyph` (Primitives.kt). RemoteViews can set a drawable but never start one, so an ImageView
  would hold the first frame for ever; a ProgressBar starts whatever Animatable it is given as its indeterminate
  drawable the first time it draws, which is what @layout/widget_working_indicator relies on.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item
        android:drawable="@drawable/widget_working_1"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_2"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_3"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_4"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_5"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_6"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_7"
        android:duration="175" />
    <item
        android:drawable="@drawable/widget_working_8"
        android:duration="175" />
</animation-list>
