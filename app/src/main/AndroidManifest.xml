<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Live notifications for running agents: the Android counterpart of the iOS app's Live Activities. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the run streams alive while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 16 Live Updates: status-bar chip, lock-screen slot, always-on display. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- In-app updates from GitHub releases: hand the downloaded APK to PackageInstaller ("Install unknown apps" must
         be allowed by the user), and on Android 12+ apply a self-update without a confirmation dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The periodic update check is a persisted JobScheduler job, which needs this to survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android 11 hides other packages unless they are declared here. Settings pages are resolved before they are
      offered, so without this the Live Updates entry would look absent on every device from Android 11 on.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_APP_PROMOTED_NOTIFICATIONS" />
        </intent>
    </queries>

    <application
        android:name=".CursorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cursor"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Cursor.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open https://cursor.com/agents/bc-... links directly in the app. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="cursor.com" />
                <data android:host="www.cursor.com" />
                <data android:pathPrefix="/agents/" />
            </intent-filter>
            <!-- Appear in the system share sheet. Separate filters per type: some OEMs drop a SEND filter that lists both. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          CursorApp supplies WorkManager's configuration (see its workManagerConfiguration), which the default
          initializer would ignore. The other initializers in this provider are still wanted.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Crash reporting is opt-in (crash/CrashReporting.kt), so the Sentry SDK's own start-up hooks are removed: it
          must not initialise itself, or measure the app's start, before the user has turned it on in Settings.
        -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />

        <!-- Streams the active runs and owns the live notification while at least one agent is running. -->
        <service
            android:name=".notifications.LiveNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The live notification's safety net: while the service is gone (killed, timed out, or the phone rebooted),
             a persisted job reads the running agents' run records and posts the "Finished" cards. -->
        <service
            android:name=".notifications.FinishWatchdogJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- PackageInstaller reports the outcome of an update session here. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Periodic check for a new GitHub release; downloads on Wi-Fi and installs while the app is not in use. -->
        <service
            android:name=".update.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The "Chats" home-screen widget: recent, running or pinned chats as sidebar rows. -->
        <receiver
            android:name=".widget.ChatsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chats_info" />
        </receiver>
        <!--
          Picks what a widget lists; opened by the launcher when a widget is placed or reconfigured, and by the
          widget's own title. Its own task, so leaving it from the widget lands back on the home screen rather than
          in the app.
        -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_configure_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Cursor">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
