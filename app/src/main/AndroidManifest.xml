<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Live notifications for running agents: the Android counterpart of the iOS app's Live Activities. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the run streams alive while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 16 Live Updates: status-bar chip, lock-screen slot, always-on display. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".CursorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cursor"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Cursor.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open https://cursor.com/agents/bc-... links directly in the app. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="cursor.com" />
                <data android:pathPrefix="/agents/" />
            </intent-filter>
        </activity>

        <!-- Streams the active runs and owns the live notification while at least one agent is running. -->
        <service
            android:name=".notifications.LiveNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The "Chats" home-screen widget: recent, running or pinned chats as sidebar rows. -->
        <receiver
            android:name=".widget.ChatsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chats_info" />
        </receiver>
        <!--
          Picks what a widget lists; opened by the launcher when a widget is placed or reconfigured, and by the
          widget's own title. Its own task, so leaving it from the widget lands back on the home screen rather than
          in the app.
        -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_configure_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Cursor">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
