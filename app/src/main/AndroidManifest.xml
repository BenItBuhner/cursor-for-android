<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Live notifications for running agents: the Android counterpart of the iOS app's Live Activities. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the run streams alive while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 16 Live Updates: status-bar chip, lock-screen slot, always-on display. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- In-app updates from GitHub releases: hand the downloaded APK to PackageInstaller ("Install unknown apps" must
         be allowed by the user), and on Android 12+ apply a self-update without a confirmation dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The periodic update check is a persisted JobScheduler job, which needs this to survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CursorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cursor"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Cursor.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open https://cursor.com/agents/bc-... links directly in the app. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="cursor.com" />
                <data android:pathPrefix="/agents/" />
            </intent-filter>
        </activity>

        <!-- Streams the active runs and owns the live notification while at least one agent is running. -->
        <service
            android:name=".notifications.LiveNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- PackageInstaller reports the outcome of an update session here. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Periodic check for a new GitHub release; downloads on Wi-Fi and installs while the app is not in use. -->
        <service
            android:name=".update.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
