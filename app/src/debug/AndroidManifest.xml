<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: permit cleartext to the emulator host so the updater can be exercised against a local
         stand-in for the GitHub API (see app/build.gradle.kts, app.updateApiBaseUrl). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only: starts a turn in a demo chat "elsewhere", for showing the pull to catch up (adb). -->
        <receiver
            android:name=".debug.TurnElsewhereReceiver"
            android:exported="true" />
    </application>
</manifest>
